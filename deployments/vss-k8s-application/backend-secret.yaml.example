apiVersion: v1
kind: Secret
metadata:
  name: video-backend-secret
  namespace: NAMESPACE
type: Opaque
# Template only — copy to backend-secret.yaml (gitignored) and fill credentials.
stringData:
  config.yaml: |
    # VastDB Settings
    vdb_endpoint: "http://"
    vdb_bucket: "vss-db"
    vdb_schema: "vss-schema"
    vdb_collection: "vss-collection"
    vdb_prompts_collection: "vss-prompts-events"
    vdb_access_key: ""
    vdb_secret_key: ""
    
    # S3 Settings
    s3_endpoint: "http://"
    s3_access_key: ""
    s3_secret_key: ""
    s3_upload_bucket: "vss-chunks"
    s3_segments_bucket: "vss-chunks-segments"
    s3_region: "us-east-1"
    s3_use_ssl: false
    
    # -------------------------------------------------------------------------
    # Cosmos-Embed1 NIM (local: -p 8002:8000) or NVIDIA Cloud
    # -------------------------------------------------------------------------
    embedding_local_nim: true
    embedding_host: ""
    embedding_port: 8002
    embedding_http_scheme: "http"
    embedding_model: "nvidia/cosmos-embed1"
    embedding_dimensions: 256
    visual_embedding_model: "nvidia/cosmos-embed1"
    visual_embedding_dimensions: 256
    hybrid_text_weight: 0.6
    
    # -------------------------------------------------------------------------
    # LLM Settings
    # -------------------------------------------------------------------------
    # llm_local_nim: true  = local NIM (no API key sent)
    # llm_local_nim: false = NVIDIA Cloud (sends nvidia_api_key)
    # Always set host/port/scheme for the endpoint you want to use
    llm_local_nim: false
    llm_model_name: "meta/llama-3.1-8b-instruct"
    llm_host: "integrate.api.nvidia.com"
    llm_port: 443
    llm_http_scheme: "https"
    llm_timeout_seconds: 10

    # -------------------------------------------------------------------------
    # NVIDIA API Key (required when using NVIDIA Cloud)
    # -------------------------------------------------------------------------
    # Required when embedding_local_nim or llm_local_nim is false
    nvidia_api_key: "nvapi-xxx"
    
    # Upload Settings
    max_upload_size_mb: 100
    
    # VAST VMS auth (user login validated via /api/token/)
    vast_host: ""
    tenant_name: "default"
    # jwt_secret MUST be a long random string (e.g. `openssl rand -hex 32`).
    # Backend refuses to start if empty. Reuse on upgrades or sessions invalidate.
    jwt_secret: ""
